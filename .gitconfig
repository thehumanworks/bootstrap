[user]
  name = Tomas Roda
  email = rodat.dev@proton.me
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[pull]
  rebase = false
[credential "https://github.com"]
  helper =
  helper = "!FNOX_CONFIG_DIR=/nonexistent fnox --non-interactive -c \"$HOME/.config/fnox/config.toml\" -P github --no-defaults exec -- gh auth git-credential"
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true
