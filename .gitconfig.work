[user]
  name = Tomas Roda
  email = rodat@leadforensics.com
[init]
  defaultBranch = main
[push]
  autoSetupRemote = true
[pull]
  rebase = false
[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[credential "https://leadforensics.ghe.com"]
  helper =
  helper = !fnox run --profile work-github --no-defaults --if-missing error --non-interactive -- gh auth git-credential
[credential "https://github.com"]
  helper =
  helper = "!f() { echo username=x-access-token; echo \"password=$MISE_GITHUB_TOKEN\"; }; f"
