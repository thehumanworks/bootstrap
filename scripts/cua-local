#!/bin/bash
set -euo pipefail
script_path="${BASH_SOURCE[0]}"
while [[ -L "$script_path" ]]; do
	script_dir="$(cd -P "$(dirname "$script_path")" && pwd)"
	script_path="$(readlink "$script_path")"
	[[ "$script_path" = /* ]] || script_path="$script_dir/$script_path"
done
repo_dir="$(cd -P "$(dirname "$script_path")/.." && pwd)"
cua_source="${CUA_LOCAL_SOURCE:-$repo_dir/tools/cua-local}"
if [[ -z "${CUA_LOCAL_SOURCE:-}" && ! -d "$cua_source/cua_local" ]]; then
	cua_source="$HOME/projects/cua-local"
fi
if [[ ! -d "$cua_source/cua_local" ]]; then
	echo "Cua source not found; set CUA_LOCAL_SOURCE to the directory containing cua_local/." >&2
	exit 1
fi
cua_home="${CUA_LOCAL_HOME:-$HOME/.local/share/cua-local}"
if [[ ! -x "$cua_home/venv/bin/python" ]]; then
	echo "Run mise -C $repo_dir run cua:setup first." >&2
	exit 1
fi
export PYTHONPATH="$cua_source${PYTHONPATH:+:$PYTHONPATH}"
export HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 TOKENIZERS_PARALLELISM=false
exec "$cua_home/venv/bin/python" -m cua_local "$@"
